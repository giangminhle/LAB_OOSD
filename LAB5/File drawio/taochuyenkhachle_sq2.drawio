        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Seq_ThemChuyen\nskinparam shadowing false\nautonumber\n\nactor \&quot;NV điều hành\&quot; as NV\nboundary \&quot;FrmChuyenLe\&quot; as Frm\ncontrol \&quot;ChuyenLeService\&quot; as Svc\ndatabase \&quot;Db (SQL Server)\&quot; as DB\n\nNV -&gt; Frm : Nhập MaChuyen, chọn Tour, NgayDi, DiaDiemDon\nNV -&gt; Frm : Nhấn nút \&quot;Tạo chuyến\&quot;\nactivate Frm\n\nFrm -&gt; Svc : ThemChuyen(ma, maTour, ngayDi, diaDiemDon)\nactivate Svc\n\nSvc -&gt; Svc : Kiểm tra thông tin rỗng\nSvc -&gt; DB : Scalar(\&quot;SELECT SoNgay FROM Tour WHERE MaTour = @t AND DangMoBan = 1\&quot;)\nactivate DB\nDB --&gt; Svc : Trả về SoNgay (hoặc null)\ndeactivate DB\n\nalt [Tour không tồn tại hoặc chưa mở bán (null)]\n    Svc --&gt; Frm : KetQuaXuLy.Fail(\&quot;Tour không tồn tại hoặc chưa mở bán.\&quot;)\n    Frm --&gt; NV : Hiển thị MessageBox báo lỗi\nelse [Dữ liệu hợp lệ]\n    Svc -&gt; Svc : Tính ngayVe = ngayDi + SoNgay - 1\n    Svc -&gt; DB : Execute(\&quot;INSERT INTO ChuyenLe...\&quot;)\n    note right: Ghi trạng thái mặc định là \&quot;Mở đăng ký\&quot;\n    activate DB\n    DB --&gt; Svc : Thành công (1 dòng ảnh hưởng)\n    deactivate DB\n    Svc --&gt; Frm : KetQuaXuLy.Ok(\&quot;Đã tạo chuyến; ngày về...\&quot;)\n    \n    Frm -&gt; Svc : LayChuyen() (Để nạp lại danh sách)\n    Svc -&gt; DB : Query(\&quot;SELECT * FROM ChuyenLe...\&quot;)\n    activate DB\n    DB --&gt; Svc : DataTable\n    deactivate DB\n    Svc --&gt; Frm : DataTable\n    \n    Frm --&gt; NV : Cập nhật lại lưới DataGridView và báo thành công\nend\n\ndeactivate Svc\ndeactivate Frm\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="joOvq2qW6r2bBcV6H3yX-1">
