        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Seq_ThemTour\nskinparam shadowing false\nautonumber\n\nactor \&quot;NV điều hành\&quot; as NV\nboundary \&quot;FrmTour\&quot; as Frm\ncontrol \&quot;TourService\&quot; as Svc\ndatabase \&quot;Db (SQL Server)\&quot; as DB\n\nNV -&gt; Frm : Nhập MaTour, TenTour, SoNgay, SoDem,\\nDonGia, MoTa\nNV -&gt; Frm : Nhấn \&quot;Thêm tour\&quot; (btnThemTour_Click)\nactivate Frm\n\nFrm -&gt; Svc : ThemTour(ma, ten, soNgay, soDem, donGia, moTa)\nactivate Svc\n\nSvc -&gt; Svc : Kiểm tra hợp lệ (mã, tên rỗng,\\nsố ngày &lt;= 0...)\nalt [Dữ liệu không hợp lệ]\n    Svc --&gt; Frm : KetQuaXuLy.Fail(\&quot;Dữ liệu không hợp lệ\&quot;)\n    Frm --&gt; NV : Hiển thị thông báo lỗi (MessageBox)\nelse [Dữ liệu hợp lệ]\n    Svc -&gt; DB : Execute(\&quot;INSERT INTO Tour...\&quot;)\n    activate DB\n    DB --&gt; Svc : Số dòng ảnh hưởng (1)\n    deactivate DB\n    Svc --&gt; Frm : KetQuaXuLy.Ok(\&quot;Đã thêm tour.\&quot;)\n    \n    Frm -&gt; Svc : LayTour() (để nạp lại lưới dữ liệu)\n    Svc -&gt; DB : Query(\&quot;SELECT * FROM Tour\&quot;)\n    activate DB\n    DB --&gt; Svc : DataTable (danh sách tour)\n    deactivate DB\n    Svc --&gt; Frm : DataTable\n    \n    Frm --&gt; NV : Cập nhật DataGridView và báo thành công\nend\n\ndeactivate Svc\ndeactivate Frm\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hgFnu-SwDqbMHgIjkB9t-1">
